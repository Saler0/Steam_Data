PYTHONUNBUFFERED=1
MLFLOW_TRACKING_URI=http://mlflow:5000

MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB_REVIEWS=exploitation_zone
MONGO_COLL_REVIEWS=steam_reviews
MONGO_DB_GAMES=exploitation_zone
MONGO_COLL_GAMES=juegos_steam

# LLM / DeepSeek
# Coloca aquí tu API key si vas a usar el proveedor "deepseek" en configs/events.yaml
DEEPSEEK_API_KEY=
# Si usas un proxy/endpoint compatible con DeepSeek, puedes sobreescribir la base URL
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# LLM / OpenAI
# Coloca aquí tu API key si vas a usar el proveedor "openai" en configs/events.yaml
# OPENAI_API_KEY=
# Si usas un proxy/endpoint compatible con OpenAI, puedes sobreescribir la base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json
GCS_BUCKET=gs://your-bucket
GCS_PREFIX=gs://your-bucket/mods_steam

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=steam_data_db
